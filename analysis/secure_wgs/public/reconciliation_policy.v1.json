    "SIGNAL_RESEARCH_ONLY"
  ],
  "lineage_rules": {
    "require_exact_receipt_digest": true,
    "require_lineage_sha256": true,
    "require_scientific_evidence_at_or_before_cutoff": true,
    "reject_duplicate_evidence": true
  },
  "score_policy": {
    "required_handling": "SEPARATE_NON_COMMENSURATE",
    "blending_allowed": false
  },
  "phase_policy": {
    "required_status": "UNRESOLVED",
    "inference_allowed": false,
    "unsupported_evidence_allowed": false
  },
  "chromosome_screen_policy": {
    "negative_state": "NO_SIGNAL_RESEARCH_ONLY",
    "maximum_confidence_change": 0
  },
  "human_gate": {
    "required": true,
    "decision_receipt_schema": "secure-wgs-human-decision-receipt/v1",
    "builder_may_author_decision": false,
    "allowed_decisions": [
      "APPROVED_FOR_HUMAN_RELEASE",
      "NOT_APPROVED",
      "MORE_REVIEW_REQUIRED"
    ]
  }
